# ==============================================================================
# LocalMarket — Environment Configuration Example
# Copy this file to .env and fill in real values locally. Never commit .env!
# ==============================================================================

# Server
NODE_ENV="development"
PORT="3000"
FRONTEND_URL="http://localhost:3000"

# PostgreSQL Connection String (used by Prisma ORM & pg driver)
# Example: postgresql://postgres:your_password@localhost:5432/localmarket?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/localmarket?schema=public"

# Authentication Secrets (generate strong random 64-char hex strings for production)
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_RANDOM_REFRESH_SECRET"

# Cloudinary Object Storage (for profile, product, and service image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
